{
  "_comment": "WebStudio virtual registry seed (generated by tools/startup/scripts/build_seed.py). 値が無いキーはエンジン内蔵の既定値で動く。",
  "_machine_guid": "${GENERATE_ONCE_PER_PROFILE}",
  "HKCU": {
    "Software\\Image-Line\\Shared\\Paths": {
      "FL Studio engine": {
        "t": "REG_SZ",
        "v": "C:\\Program Files\\Image-Line\\FL Studio 2026\\FLEngine_x64.dll"
      },
      "Shared DLLs": {
        "t": "REG_SZ",
        "v": "C:\\Program Files\\Image-Line\\FL Studio 2026\\Shared\\"
      },
      "Shared data": {
        "t": "REG_SZ",
        "v": "C:\\Users\\webstudio\\Documents\\Image-Line\\"
      }
    },
    "Software\\Image-Line\\FL Studio 26\\General": {
      "Browser FL CLOUD displayed": {
        "t": "REG_SZ",
        "v": "0"
      },
      "Disable FL CLOUD search": {
        "t": "REG_SZ",
        "v": "1"
      },
      "CrashLoadingStartupProject": {
        "t": "REG_SZ",
        "v": "0"
      }
    }
  },
  "HKLM": {
    "SOFTWARE\\Microsoft\\Cryptography": {
      "MachineGuid": {
        "t": "REG_SZ",
        "v": "${MACHINE_GUID}"
      }
    },
    "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion": {
      "ProductName": {
        "t": "REG_SZ",
        "v": "Windows 10 Pro"
      },
      "CurrentVersion": {
        "t": "REG_SZ",
        "v": "6.3"
      },
      "CurrentBuild": {
        "t": "REG_SZ",
        "v": "19045"
      },
      "CurrentBuildNumber": {
        "t": "REG_SZ",
        "v": "19045"
      },
      "CurrentMajorVersionNumber": {
        "t": "REG_DWORD",
        "v": 10
      },
      "CurrentMinorVersionNumber": {
        "t": "REG_DWORD",
        "v": 0
      },
      "DisplayVersion": {
        "t": "REG_SZ",
        "v": "22H2"
      },
      "ReleaseId": {
        "t": "REG_SZ",
        "v": "2009"
      }
    },
    "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\FontSubstitutes": {
      "MS Shell Dlg 2": {
        "t": "REG_SZ",
        "v": "Tahoma"
      }
    },
    "Software\\Image-Line\\Shared\\Paths": {
      "FL Studio engine": {
        "t": "REG_SZ",
        "v": "C:\\Program Files\\Image-Line\\FL Studio 2026\\FLEngine_x64.dll"
      },
      "Shared DLLs": {
        "t": "REG_SZ",
        "v": "C:\\Program Files\\Image-Line\\FL Studio 2026\\Shared\\"
      }
    }
  },
  "_not_seeded_on_purpose": [
    "Software\\Image-Line\\Registrations\\* (ILRegKey 等): 未登録=Trial で起動。ライセンスは生成しない",
    "Software\\Image-Line\\Registrations\\Token / FL Data: FL Cloud トークン (外部通信対象外)"
  ],
  "_env": {
    "LANG": "en",
    "FLStudioData": "(engine が設定)",
    "TEMP": "C:\\Users\\webstudio\\AppData\\Local\\Temp",
    "USERPROFILE": "C:\\Users\\webstudio"
  },
  "_known_folders": {
    "CSIDL_PERSONAL(5)": "C:\\Users\\webstudio\\Documents",
    "CSIDL_APPDATA(0x1a)": "C:\\Users\\webstudio\\AppData\\Roaming",
    "CSIDL_LOCAL_APPDATA(0x1c)": "C:\\Users\\webstudio\\AppData\\Local",
    "GetTempPathW": "C:\\Users\\webstudio\\AppData\\Local\\Temp\\"
  }
}
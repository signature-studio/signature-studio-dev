# #1602 計測 patch (計測専用・本体には入れない・git apply 可)
#
# 適用先: 4c3f7458 (origin/main 相当)。`git apply --check` で確認。
# 効く条件: M11_INSTR_1602=1 (m11_build.sh の CF に -DM11_INSTR_1602 が入る)。
#   - function_535bf2 の計測本体 (読取り) は #if M11_FIX_535BF2 の内側。FIX=0 (既定) ではコンパイルされない。
#     読取りを効かせるには M11_FIX_535BF2=1 が要る。
#   - function_410b10 側の hook m11_1602_410b10 は本体が (void)obj; の空関数。読取りは含まない。
#   よって FIX=0 の INSTR=1 build で変わるのは ov.o の再ビルド (stamp) と空関数呼出しだけ。
# 測定結果と解釈: tools/m11/trap_triage/REPORT_APPENDIX_1602.md §13。
#
diff --git a/tools/m11/m11_build.sh b/tools/m11/m11_build.sh
index d715e6fc..d5001540 100755
--- a/tools/m11/m11_build.sh
+++ b/tools/m11/m11_build.sh
@@ -22,7 +22,7 @@ M11_NEG_413060="${M11_NEG_413060:-0}"   # #944 ネガコン: 1 = dest に p+0x40
 M11_INSTR_413060="${M11_INSTR_413060:-0}"   # #944: 1 = 計測専用に function_413060 へ probe (index 8) と dest 観測 hook を post で入れる。既定 0 は main と同一の post 出力
 M11_DEST_READ="${M11_DEST_READ:-1}"   # #944: 0 = 413060 後の dest 読出し (指紋) を止める。読出しが挙動を変えるかの切り分け用。既定 1
 M11_FIX_535BF2="${M11_FIX_535BF2:-0}"   # #714: 1 = m11_ov.c の function_535c11/535bf2 転記 (IR 未定義 535c2e・境界 535c11 の再現); 0 = lift 版 (既定)
-CF="-w -Wno-error=int-conversion -Wno-implicit-function-declaration -O0 -g1 -DM11_LB_BASE=$M11_LB_BASE -DM11_OV_CLASSCREATE=$M11_OV_CLASSCREATE -DM11_OV_414AD0=$M11_OV_414AD0 -DM11_FIX_652500=$M11_FIX_652500 -DM11_OV_413060=$M11_OV_413060 -DM11_NEG_413060=$M11_NEG_413060 -DM11_DEST_READ=$M11_DEST_READ -DM11_INSTR_413060=$M11_INSTR_413060 -DM11_FIX_535BF2=$M11_FIX_535BF2 -DM11_INSTR_K12=${M11_INSTR_K12:-0} -DM11_INSTR_40FF70=${M11_INSTR_40FF70:-0}"
+CF="-w -Wno-error=int-conversion -Wno-implicit-function-declaration -O0 -g1 -DM11_LB_BASE=$M11_LB_BASE -DM11_OV_CLASSCREATE=$M11_OV_CLASSCREATE -DM11_OV_414AD0=$M11_OV_414AD0 -DM11_FIX_652500=$M11_FIX_652500 -DM11_OV_413060=$M11_OV_413060 -DM11_NEG_413060=$M11_NEG_413060 -DM11_DEST_READ=$M11_DEST_READ -DM11_INSTR_413060=$M11_INSTR_413060 -DM11_FIX_535BF2=$M11_FIX_535BF2 -DM11_INSTR_K12=${M11_INSTR_K12:-0} -DM11_INSTR_40FF70=${M11_INSTR_40FF70:-0} -DM11_INSTR_1602=${M11_INSTR_1602:-0}"
 # image 終端 (SizeOfImage 0x18c0000) + LB_BASE が GLOBAL_BASE (0x10000000) 以内であること
 python3 - <<PYEOF
 import sys
@@ -179,6 +179,9 @@ echo "${M11_INSTR_K12:-0}" > work/ov_instr_k12.stamp
 # #882: 40ff70 観測 probe の ON/OFF で古い ov.o を再リンクしない
 if [ "$(cat work/ov_instr_40ff70.stamp 2>/dev/null || echo none)" != "${M11_INSTR_40FF70:-0}" ]; then rm -f work/obj/ov.o; fi
 echo "${M11_INSTR_40FF70:-0}" > work/ov_instr_40ff70.stamp
+# #1602: 1602 計測 probe の ON/OFF で古い ov.o を再リンクしない
+if [ "$(cat work/ov_instr_1602.stamp 2>/dev/null || echo none)" != "${M11_INSTR_1602:-0}" ]; then rm -f work/obj/ov.o; fi
+echo "${M11_INSTR_1602:-0}" > work/ov_instr_1602.stamp
 echo "$M11_FIX_535BF2" > work/ov_535bf2.stamp
 cc m11_ov.c work/obj/ov.o work/boot_final3_sigs.h
 cc work/m11_data.c work/obj/data.o

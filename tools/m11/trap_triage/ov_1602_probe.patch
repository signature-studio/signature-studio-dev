+        unsigned long long e = tbl + (cnt + 1) * 24;
+        int e_in = tbl_in && e + 4 <= heap;
+        if (!(self_in && p8_in && tbl_in && e_in))
+            M11_TRACE("[m11][1602] 535bf2 self=0x%llx self_in=%d [self+8]=0x%llx p8_in=%d tbl=0x%llx tbl_in=%d cnt=%llu e=0x%llx e_in=%d heap=0x%llx\n",

     u64 items;
+#if M11_INSTR_1602
+    {
+        unsigned long long heap = (unsigned long long)__builtin_wasm_memory_size(0) * 65536ULL;
+        int self_in = self >= 0x18 && self + 0x18 <= heap;
+        unsigned long long p8 = self_in ? *(volatile unsigned long long*)(uintptr_t)(self + 8) : 0;
+        int p8_in = p8 >= 8 && p8 + 16 <= heap;
+        unsigned long long tbl = p8_in ? *(volatile unsigned long long*)(uintptr_t)(p8 + 8) : 0;
+        unsigned long long cnt = self_in ? *(volatile unsigned long long*)(uintptr_t)(self + 0x10) : 0;

{
  "http_request_transform": [
    {
      "ref": "webstudio_studio_example_com_rewrite_directory_index",
      "description": "webstudio: R2 カスタムドメインは / や dir/ の index 解決をしないため、末尾 / のパスに index.html を連結 (Transform Rules: URL Rewrite)",
      "expression": "(http.host eq \"studio.example.com\") and (ends_with(http.request.uri.path, \"/\"))",
      "action": "rewrite",
      "action_parameters": {
        "uri": {
          "path": {
            "expression": "concat(http.request.uri.path, \"index.html\")"
          }
        }
      },
      "enabled": true
    }
  ],
  "http_response_headers_transform": [
    {
      "ref": "webstudio_studio_example_com_hdr_isolation",
      "description": "webstudio: crossOriginIsolated (SharedArrayBuffer) 用 COOP/COEP + CORP + nosniff",
      "expression": "(http.host eq \"studio.example.com\")",
      "action": "rewrite",
      "action_parameters": {
        "headers": {
          "Cross-Origin-Opener-Policy": {
            "operation": "set",
            "value": "same-origin"
          },
          "Cross-Origin-Embedder-Policy": {
            "operation": "set",
            "value": "require-corp"
          },
          "Cross-Origin-Resource-Policy": {
            "operation": "set",
            "value": "same-origin"
          },
          "X-Content-Type-Options": {
            "operation": "set",
            "value": "nosniff"
          }
        }
      },
      "enabled": true
    },
    {
      "ref": "webstudio_studio_example_com_hdr_cache_default",
      "description": "webstudio: 非ハッシュ名の既定: 5 分 + 再検証",
      "expression": "(http.host eq \"studio.example.com\") and (http.response.code in {200 206})",
      "action": "rewrite",
      "action_parameters": {
        "headers": {
          "Cache-Control": {
            "operation": "set",
            "value": "public, max-age=300, must-revalidate"
          }
        }
      },
      "enabled": true
    },
    {
      "ref": "webstudio_studio_example_com_hdr_cache_immutable",
      "description": "webstudio: ハッシュ付き/内容アドレス資産: 1 年 immutable",
      "expression": "(http.host eq \"studio.example.com\") and ((starts_with(http.request.uri.path, \"/assets/\") or starts_with(http.request.uri.path, \"/wasm/\") or starts_with(http.request.uri.path, \"/data/\"))) and (http.response.code in {200 206})",
      "action": "rewrite",
      "action_parameters": {
        "headers": {
          "Cache-Control": {
            "operation": "set",
            "value": "public, max-age=31536000, immutable"
          }
        }
      },
      "enabled": true
    },
    {
      "ref": "webstudio_studio_example_com_hdr_cache_document",
      "description": "webstudio: エントリ HTML / release.json / ブート manifest は常に再検証",
      "expression": "(http.host eq \"studio.example.com\") and (http.request.uri.path in {\"/\" \"/index.html\" \"/release.json\" \"/wasm/manifest.json\"}) and (http.response.code in {200 206})",
      "action": "rewrite",
      "action_parameters": {
        "headers": {
          "Cache-Control": {
            "operation": "set",
            "value": "no-cache"
          }
        }
      },
      "enabled": true
    }
  ],
  "http_request_cache_settings": [
    {
      "ref": "webstudio_studio_example_com_cache_cache_default",
      "description": "webstudio: bucket 全体をエッジキャッシュ対象に (wasm/html/json は既定では非キャッシュ)。mutable は 5 分 + デプロイ時 purge",
      "expression": "(http.host eq \"studio.example.com\")",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 300
        },
        "browser_ttl": {
          "mode": "respect_origin"
        }
      },
      "enabled": true
    },
    {
      "ref": "webstudio_studio_example_com_cache_cache_immutable",
      "description": "webstudio: 内容アドレス資産はエッジも 1 年",
      "expression": "(http.host eq \"studio.example.com\") and ((starts_with(http.request.uri.path, \"/assets/\") or starts_with(http.request.uri.path, \"/wasm/\") or starts_with(http.request.uri.path, \"/data/\")))",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 31536000
        },
        "browser_ttl": {
          "mode": "respect_origin"
        }
      },
      "enabled": true
    },
    {
      "ref": "webstudio_studio_example_com_cache_cache_document",
      "description": "webstudio: document 群は immutable prefix(/wasm/)配下でもエッジ TTL を短く(60s)。デプロイ時に purge",
      "expression": "(http.host eq \"studio.example.com\") and (http.request.uri.path in {\"/\" \"/index.html\" \"/release.json\" \"/wasm/manifest.json\"})",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 60
        },
        "browser_ttl": {
          "mode": "respect_origin"
        }
      },
      "enabled": true
    }
  ],
  "http_response_compression": [
    {
      "ref": "webstudio_studio_example_com_cmp_compress_text_wasm",
      "description": "webstudio: wasm/js/css/html/json を br 優先で圧縮 (無料プラン既定は zstd。ブラウザ互換のため br 先頭)",
      "expression": "(http.host eq \"studio.example.com\") and (http.request.uri.path.extension in {\"wasm\" \"js\" \"mjs\" \"css\" \"html\" \"json\" \"svg\" \"txt\"})",
      "action": "compress_response",
      "action_parameters": {
        "algorithms": [
          {
            "name": "brotli"
          },
          {
            "name": "zstd"
          },
          {
            "name": "gzip"
          }
        ]
      },
      "enabled": true
    }
  ]
}

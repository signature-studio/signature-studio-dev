# deploy/.env にコピーして編集 (gitignore 済み)。secret は書かない/コミットしない。

# --- 配信先 (Workers Static Assets。URL は https://<WORKER_NAME>.<account の workers.dev サブドメイン>.workers.dev) ---
WORKER_NAME=signature-studio

# --- 認証 (どちらか) ---
# (a) cf auth login + bunx wrangler login (OAuth)。deploy/scripts/00-preflight.sh がスコープを検査する
# (b) API トークン (最小権限は deploy/README.md §トークン権限)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=             # アカウントが 1 つなら省略可

# --- Access (worker 型) ---
# 人間ポリシー: 未指定なら include: Everyone (ログイン必須・この Zero Trust 組織のユーザならログイン可。ユーザ決定 2026-10-10)。
# 後日絞り込む/追加する: ACCESS_ALLOW_EMAILS=you@example.com (カンマ区切り) / ACCESS_ALLOW_EMAIL_DOMAIN=example.com。
# ACCESS_ALLOW_EVERYONE=1 を併記すると Everyone + 指定メールの両方。変更後 `node deploy/scripts/40-access.mjs --apply` で再適用 (RUNBOOK §4)。
ACCESS_ALLOW_EMAILS=
# ACCESS_SERVICE_TOKEN_NAME=signature-studio-e2e   # 省略時 ${WORKER_NAME}-e2e。secret は deploy/work/secrets/ に 0600 で保存
# ACCESS_SESSION_DURATION=24h

# --- 配備物の検査 ---
# STATIC_ASSETS_MAX_FILES=20000       # Free 20,000 / Paid 100,000
# STAGE_EXTRA_IMMUTABLE=/c/,/m/       # edge-policy 正本に未収載の immutable prefix (tools/assets の chunk 配置)
# STAGE_EXTRA_DOCUMENT=/latest.json

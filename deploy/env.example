# deploy/.env にコピーして編集 (gitignore 済み)。secret は書かない/コミットしない。

# --- 配信先 ---
CF_ZONE=example.com                 # Cloudflare に載っているゾーン (apex ドメイン)
CF_HOSTNAME=studio.example.com      # 公開ホスト名 = R2 カスタムドメイン = Access Self-hosted App のホスト
CF_R2_BUCKET=webstudio-prod

# --- 認証 (どちらか) ---
# (a) cf auth login (OAuth)。deploy/scripts/00-preflight.sh がスコープを検査する
# (b) API トークン (最小権限は deploy/README.md §トークン権限)
# CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Access ---
ACCESS_ALLOW_EMAILS=you@example.com           # カンマ区切り。または ACCESS_ALLOW_EMAIL_DOMAIN=example.com
# ACCESS_SERVICE_TOKEN_NAME=webstudio-e2e     # E2E/CI 用 (secret は deploy/work/secrets/ に 0600 で保存)

# --- 大容量 (>300MB) / Cache-Control をオブジェクトに持たせる場合のみ: R2 S3 互換キー ---
# R2_S3_ACCESS_KEY_ID=
# R2_S3_SECRET_ACCESS_KEY=

{
  "name": "signature-studio-pm-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test 'test/*.test.ts'",
    "test:workers": "vitest run --config vitest.config.ts",
    "build": "bun build src/index.ts --target=browser --format=esm --external 'node:*' --minify --outfile=dist/index.js",
    "metadata": "node scripts/metadata.mjs",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.150.0"
  }
}
